# Milo Mobile (Expo) Environment Configuration
# These variables are exposed to the mobile client runtime by Expo.
# Data access is protected by Supabase PostgreSQL Row Level Security (RLS) policies.
#
# CRITICAL SECURITY RULE:
# NEVER place SUPABASE_SERVICE_ROLE_KEY or database connection strings in this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Feature flags (client-visible). Leave OFF until the matching server secrets and
# credentials are attached (see docs/SECRETS_CHECKLIST.md). Only the exact value "true" enables.
EXPO_PUBLIC_FEATURE_BILLING=false
EXPO_PUBLIC_FEATURE_PUSH=false
EXPO_PUBLIC_FEATURE_CALLS=false
EXPO_PUBLIC_FEATURE_VOICE_MESSAGES=false
EXPO_PUBLIC_FEATURE_COIN_TOPUP=false
