{
  "expo": {
    "name": "Chahat \u2014 Online Friendship App",
    "slug": "chahat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "milo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
  "image": "./assets/splash-icon.png",
  "resizeMode": "contain",
  "backgroundColor": "#FAF7F5",
  "dark": {
    "image": "./assets/splash-icon.png",
    "backgroundColor": "#161014"
  }
},
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.milo.dating"
    },
    "android": {
      "package": "com.milo.dating",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#20000D"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chahat uses your location only when you choose nearby discovery."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chahat needs access to your photos so you can add pictures to your friendship profile."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d40a4e1f-fbf8-4b44-93af-7c4e1fe39b8a"
      }
    },
    "owner": "chahat-org"
  }
}