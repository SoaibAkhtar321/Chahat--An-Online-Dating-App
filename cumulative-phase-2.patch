index 0000000..4a2ae47
--- /dev/null
+++ b/mobile/src/services/pendingSignup.ts
@@ -0,0 +1,15 @@
+// Holds the credentials of a signup that is waiting for e-mail confirmation. Memory only: never written to storage,
+// never put in navigation params or logs, and cleared as soon as the account is confirmed or the person leaves.
+let pending: { email: string; password: string } | null = null;
+
+export function setPendingSignup(email: string, password: string): void {
+  pending = { email: email.trim().toLowerCase(), password };
+}
+
+export function getPendingSignup(): { email: string; password: string } | null {
+  return pending;
+}
+
+export function clearPendingSignup(): void {
+  pending = null;
+}
diff --git a/mobile/src/services/secureKey.ts b/mobile/src/services/secureKey.ts
new file mode 100644
index 0000000..afece9e
--- /dev/null
+++ b/mobile/src/services/secureKey.ts
@@ -0,0 +1,7 @@
+// expo-secure-store only accepts keys made of letters, digits, ".", "-" and "_". Any other character (for example the
+// ":" used when a key embeds a user id) makes every read/write/delete throw "Invalid key provided to SecureStore".
+// All SecureStore keys in the app must go through this helper.
+export function secureKey(raw: string): string {
+  const cleaned = raw.replace(/[^A-Za-z0-9._-]/g, "_");
+  return cleaned.length > 0 ? cleaned : "_";
+}
