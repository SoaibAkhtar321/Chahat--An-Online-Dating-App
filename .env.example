# ==============================================================================
# Milo Dating Platform — Environment Variables Reference Template
# ==============================================================================
# IMPORTANT SECURITY GUIDELINES:
# 1. Do NOT commit real credentials or secret keys to Git.
# 2. Never bundle or expose SUPABASE_SERVICE_ROLE_KEY or database connection URLs
#    in client bundles (Vite web client or Expo mobile application).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Mobile Client Application (Expo / React Native)
# ------------------------------------------------------------------------------
# Injected into the React Native mobile client via Expo at build time.
# Protected at rest by Supabase PostgreSQL Row Level Security (RLS).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# 2. Web Client Application (Vite Prototype)
# ------------------------------------------------------------------------------
# Replaced at build time into client-side web bundles.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# 3. Server-Side Runtime (TanStack Start SSR / Supabase Edge Functions)
# ------------------------------------------------------------------------------
# SERVER-SIDE ONLY: Never expose to browser or mobile application.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional server webhook / cron secrets (Lovable Cloud)
LOVABLE_CRON_SECRET=your-server-cron-secret
LOVABLE_CRON_SECRET_PREVIOUS=your-previous-cron-secret

# ------------------------------------------------------------------------------
# 4. Database Migration & Tooling (drizzle-kit CLI only)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string used ONLY when running database schema
# migrations from developer workstation or secure CI/CD pipelines.
LOVABLE_DB_MIGRATION_URL=postgresql://postgres:password@your-project.pooler.supabase.com:6543/postgres
