diff --git a/mobile/src/services/messageDeletion.ts b/mobile/src/services/messageDeletion.ts
new file mode 100644
index 0000000..d61f864
--- /dev/null
+++ b/mobile/src/services/messageDeletion.ts
@@ -0,0 +1,206 @@
+import { supabase, isSupabaseConfigured } from "./supabase";
+import { isValidUUID } from "../utils/validation";
+import type { Message } from "../types";
+
+/**
+ * Client for the Phase 3A message deletion RPCs (supabase/migrations/20260101004200_message_deletion.sql):
+ *   delete_message_for_me(_message_id uuid)        any participant, any message in the match
+ *   delete_message_for_everyone(_message_id uuid)  sender only
+ * Both return jsonb: { success: true, status, message_id, deleted_at? } or { success: false, error }.
+ * Both are idempotent (`already_deleted`), which is what makes retrying after a network failure safe.
+ */
+
+export type DeleteScope = "me" | "everyone";
+
+export type DeleteFailureReason =
+  | "invalid_id"
+  | "message_not_found"
+  | "forbidden"
+  | "account_not_active"
+  | "account_deletion_pending"
+  | "auth_required"
+  | "unavailable"
+  | "network"
+  | "unknown";
+
+export type DeleteMessageResult =
+  | {
+      ok: true;
+      status: "deleted_for_me" | "deleted" | "already_deleted";
+      messageId: string;
+      /** Server tombstone time for Delete for everyone. Absent for Delete for me. */
+      deletedAt?: string;
+      /** True when no backend is configured (local preview): nothing was sent to a server. */
+      local?: boolean;
+      attempts: number;
+    }
+  | {
+      ok: false;
+      reason: DeleteFailureReason;
+      /** True when trying again later could succeed (connectivity / server trouble). */
+      retryable: boolean;
+      message: string;
+      attempts: number;
+    };
+
+export const RPC_NAME: Record<DeleteScope, string> = {
+  me: "delete_message_for_me",
+  everyone: "delete_message_for_everyone",
+};
+
+/** Waits before retry 1 and retry 2, so at most 3 attempts per user action. */
+export const RETRY_DELAYS_MS: readonly number[] = [400, 1200];
+
+const FAILURE_MESSAGES: Record<DeleteFailureReason, string> = {
+  invalid_id: "This message can't be deleted right now.",
+  message_not_found: "This message is no longer available.",
+  forbidden: "You can only delete your own messages for everyone.",
+  account_not_active: "Your account can't delete messages for everyone right now.",
+  account_deletion_pending: "Messages can't be deleted while your account deletion is pending.",
+  auth_required: "Your session has expired. Please sign in again.",
+  unavailable: "Message deletion isn't available yet. Please try again later.",
+  network: "Couldn't reach the server. Check your connection and try again.",
+  unknown: "Something went wrong. Please try again.",
+};
+
+function failure(reason: DeleteFailureReason, attempts: number, retryable = false): DeleteMessageResult {
+  return { ok: false, reason, retryable, message: FAILURE_MESSAGES[reason], attempts };
+}
+
+interface RpcErrorLike {
+  message?: string;
+  code?: string;
+}
+
+/** Maps a transport / PostgREST error to a failure reason. Only connectivity and 5xx/429 are retryable. */
+export function classifyRpcError(
+  error: RpcErrorLike | null | undefined,
+  status?: number,
+): { reason: DeleteFailureReason; retryable: boolean } {
+  const message = String(error?.message ?? "");
+  const code = String(error?.code ?? "");
+
+  if (/authentication required/i.test(message) || /jwt/i.test(message) || code === "PGRST301") {
+    return { reason: "auth_required", retryable: false };
+  }
+  // Function missing = Phase 3A migration not applied on this project. Retrying cannot help.
+  if (code === "PGRST202" || code === "42883" || /could not find the function/i.test(message)) {
+    return { reason: "unavailable", retryable: false };
+  }
+  if (typeof status === "number" && (status >= 500 || status === 429 || status === 408)) {
+    return { reason: "network", retryable: true };
+  }
+  if (!code && /network|fetch|timeout|timed out|connection|offline|socket/i.test(message)) {
+    return { reason: "network", retryable: true };
+  }
+  return { reason: "unknown", retryable: false };
+}
+
+const KNOWN_RPC_ERRORS: ReadonlySet<string> = new Set([
+  "message_not_found",
+  "forbidden",
+  "account_not_active",
+  "account_deletion_pending",
+]);
+
+/** Delete for me is allowed on any message in the match (including a tombstone). */
+export function canDeleteForMe(message: Pick<Message, "id">): boolean {
+  return isValidUUID(message.id);
+}
+
+/** Delete for everyone: only the sender, only while the message still has content. */
+export function canDeleteForEveryone(
+  message: Pick<Message, "id" | "sender" | "deletedAt">,
+  currentUserId: string | null | undefined,
+): boolean {
+  return (
+    !!currentUserId &&
+    message.sender === currentUserId &&
+    !message.deletedAt &&
+    isValidUUID(message.id)
+  );
+}
+
+interface DeleteOptions {
+  /** Test seam. Defaults to setTimeout. */
+  sleep?: (ms: number) => Promise<void>;
+  delaysMs?: readonly number[];
+}
+
+const defaultSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+export async function deleteMessage(
+  scope: DeleteScope,
+  messageId: string,
+  options: DeleteOptions = {},
+): Promise<DeleteMessageResult> {
+  if (!messageId || !isValidUUID(messageId)) return failure("invalid_id", 0);
+
+  // Local preview without a backend: mirror what the server would do, nothing leaves the device.
+  if (!isSupabaseConfigured()) {
+    return {
+      ok: true,
+      status: scope === "me" ? "deleted_for_me" : "deleted",
+      messageId,
+      deletedAt: scope === "everyone" ? new Date().toISOString() : undefined,
+      local: true,
+      attempts: 0,
+    };
+  }
+
+  const sleep = options.sleep ?? defaultSleep;
+  const delays = options.delaysMs ?? RETRY_DELAYS_MS;
+  const maxAttempts = delays.length + 1;
+  let last: DeleteMessageResult = failure("unknown", 0);
+
+  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
+    last = await callOnce(scope, messageId, attempt);
+    if (last.ok || !last.retryable) return last;
+    if (attempt < maxAttempts) await sleep(delays[attempt - 1] ?? 0);
+  }
+  return last;
+}
+
+async function callOnce(scope: DeleteScope, messageId: string, attempt: number): Promise<DeleteMessageResult> {
+  try {
+    const res: any = await supabase.rpc(RPC_NAME[scope], { _message_id: messageId });
+    if (res?.error) {
+      const { reason, retryable } = classifyRpcError(res.error, res.status);
+      return failure(reason, attempt, retryable);
+    }
+
+    const data = res?.data;
+    if (!data || typeof data !== "object") return failure("unknown", attempt);
+
+    if (data.success === false) {
+      const code = String(data.error ?? "");
+      return failure(KNOWN_RPC_ERRORS.has(code) ? (code as DeleteFailureReason) : "unknown", attempt);
+    }
+    if (data.success !== true) return failure("unknown", attempt);
+
+    const status =
+      data.status === "deleted_for_me" || data.status === "deleted" || data.status === "already_deleted"
+        ? data.status
+        : scope === "me"
+          ? "deleted_for_me"
+          : "deleted";
+
+    return {
+      ok: true,
+      status,
+      messageId,
+      deletedAt: scope === "everyone" && typeof data.deleted_at === "string" ? data.deleted_at : undefined,
+      attempts: attempt,
+    };
+  } catch (err: any) {
+    // supabase-js normally returns errors; a throw here is almost always a transport failure.
+    const { reason, retryable } = classifyRpcError({ message: err?.message ?? "network error" });
+    return failure(reason === "unknown" ? "network" : reason, attempt, reason === "unknown" ? true : retryable);
+  }
+}
+
+export const deleteMessageForMe = (messageId: string, options?: DeleteOptions) =>
+  deleteMessage("me", messageId, options);
+
+export const deleteMessageForEveryone = (messageId: string, options?: DeleteOptions) =>
+  deleteMessage("everyone", messageId, options);
diff --git a/mobile/src/utils/messageState.ts b/mobile/src/utils/messageState.ts
new file mode 100644
index 0000000..a7b4db6
--- /dev/null
+++ b/mobile/src/utils/messageState.ts
@@ -0,0 +1,135 @@
+import type { Message } from "../types";
+
+/**
+ * Pure helpers for chat message state. No React, no network: everything here is unit-testable.
+ *
+ * Two kinds of "gone" messages exist (see docs/MESSAGE_DELETION.md):
+ *  - hidden:     "Delete for me". The server stops returning the row to this user. The client keeps the
+ *                id in a local set so a stale fetch or a late event can never bring it back.
+ *  - tombstoned: "Delete for everyone". The row stays, content is scrubbed, `deletedAt` is set.
+ *                The client keeps id -> deletedAt so a stale fetch can never show the old content again.
+ */
+
+export const DELETED_PREVIEW_TEXT = "This message was deleted";
+export const DELETED_BY_ME_PREVIEW_TEXT = "You deleted this message";
+
+export interface DeletionContext {
+  hidden: ReadonlySet<string>;
+  tombstones: ReadonlyMap<string, string>;
+}
+
+export function isTombstone(message: Pick<Message, "deletedAt"> | null | undefined): boolean {
+  return !!message?.deletedAt;
+}
+
+type Signed = Record<string, string | undefined | null>;
+
+/** Maps a `messages` row (table, RPC or Realtime payload) to the client Message shape. */
+export function mapMessageRow(row: any, currentUserId: string, signed: Signed = {}): Message {
+  const deletedAt: string | null = row.deleted_at ?? null;
+  const base = {
+    id: row.id as string,
+    matchId: row.match_id as string,
+    sender: row.sender as string,
+    from: (row.sender === currentUserId ? "me" : "them") as "me" | "them",
+    at: new Date(row.created_at).getTime(),
+    status: (row.read_at ? "read" : "sent") as "read" | "sent",
+  };
+
+  // A tombstone never carries content, whatever the row says (defence in depth for the table fallback path).
+  if (deletedAt) {
+    return {
+      ...base,
+      text: "",
+      messageType: "text",
+      isViewOnce: false,
+      viewedAt: null,
+      deletedAt,
+    };
+  }
+
+  return {
+    ...base,
+    text: row.body ?? "",
+    image: row.image_path ? (signed[row.image_path] ?? undefined) : undefined,
+    audio: row.audio_path ? (signed[row.audio_path] ?? undefined) : undefined,
+    audioDurationSec: row.audio_duration_sec,
+    messageType: row.message_type || (row.audio_path ? "voice" : row.image_path ? "image" : "text"),
+    isViewOnce: !!row.is_view_once,
+    viewedAt: row.viewed_at ?? null,
+    deletedAt: null,
+  };
+}
+
+/** Returns the message with all content removed and `deletedAt` set. Keeps identity, side and time. */
+export function tombstoneMessage(message: Message, deletedAt: string): Message {
+  return {
+    id: message.id,
+    matchId: message.matchId,
+    sender: message.sender,
+    from: message.from,
+    text: "",
+    messageType: "text",
+    isViewOnce: false,
+    viewedAt: null,
+    deletedAt,
+    at: message.at,
+    status: message.status,
+  };
+}
+
+export function removeMessage(list: Message[], id: string): Message[] {
+  return list.some((m) => m.id === id) ? list.filter((m) => m.id !== id) : list;
+}
+
+/** Inserts (or replaces) a message at its chronological place. Used to roll back an optimistic delete. */
+export function insertChronologically(list: Message[], message: Message): Message[] {
+  const without = list.filter((m) => m.id !== message.id);
+  const index = without.findIndex((m) => m.at > message.at);
+  if (index === -1) return [...without, message];
+  return [...without.slice(0, index), message, ...without.slice(index)];
+}
+
+/** Applies a tombstone to a message that is already in the list. Unknown ids are ignored, never added. */
+export function applyTombstone(list: Message[], id: string, deletedAt: string): Message[] {
+  const index = list.findIndex((m) => m.id === id);
+  if (index === -1) return list;
+  const current = list[index]!;
+  if (current.deletedAt) return list;
+  const next = list.slice();
+  next[index] = tombstoneMessage(current, deletedAt);
+  return next;
+}
+
+/**
+ * Adds a message that arrived through Realtime INSERT. It is appended (newest last, as before), never duplicated,
+ * never added when the user hid it, and never shown with content when it is already known to be tombstoned.
+ */
+export function appendIncoming(list: Message[], incoming: Message, ctx: DeletionContext): Message[] {
+  if (ctx.hidden.has(incoming.id)) return list;
+  if (list.some((m) => m.id === incoming.id)) return list;
+  const knownDeletedAt = ctx.tombstones.get(incoming.id);
+  const message = knownDeletedAt && !incoming.deletedAt ? tombstoneMessage(incoming, knownDeletedAt) : incoming;
+  return [...list, message];
+}
+
+/**
+ * Cleans a fresh server fetch before it replaces the list. Covers a fetch that started before a delete was
+ * committed and answers after the optimistic update: hidden rows are dropped, tombstoned rows lose their content.
+ */
+export function reconcileFetched(fetched: Message[], ctx: DeletionContext): Message[] {
+  const result: Message[] = [];
+  for (const message of fetched) {
+    if (ctx.hidden.has(message.id)) continue;
+    const knownDeletedAt = ctx.tombstones.get(message.id);
+    result.push(knownDeletedAt && !message.deletedAt ? tombstoneMessage(message, knownDeletedAt) : message);
+  }
+  return result;
+}
+
+/** Text for chat-list previews. Never exposes content of a deleted message. */
+export function messagePreviewText(message: Message | null | undefined, fallback = "Shared an image"): string {
+  if (!message) return "";
+  if (message.deletedAt) return message.from === "me" ? DELETED_BY_ME_PREVIEW_TEXT : DELETED_PREVIEW_TEXT;
+  return message.text || fallback;
+}
diff --git a/__tests__/messageDeletionClient.test.ts b/__tests__/messageDeletionClient.test.ts
