+        if (!row?.id || !row.deleted_at) return;
+        handlers?.onMessageDeleted?.({ id: row.id, deletedAt: row.deleted_at });
+      },
+    )
+    .subscribe((status) => {
+      if (status !== "SUBSCRIBED") return;
+      if (hasSubscribed) handlers?.onResync?.();
+      hasSubscribed = true;
+    });
 }
