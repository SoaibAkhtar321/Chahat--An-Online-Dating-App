diff --git a/supabase/migrations/20260101000800_photo_visibility_stopgap.sql b/supabase/migrations/20260101000800_photo_visibility_stopgap.sql
new file mode 100644
index 0000000..54c5bab
--- /dev/null
+++ b/supabase/migrations/20260101000800_photo_visibility_stopgap.sql
@@ -0,0 +1,71 @@
+-- 20260101000800_photo_visibility_stopgap.sql
+-- EMERGENCY STOPGAP (task 1A): until per-photo moderation exists (1B/1D), user photos are visible
+-- ONLY to their owner. Nothing here approves, deletes or modifies any existing photo data.
+-- Closes four read paths: (1) storage SELECT, (2) get_public_profile, (3) get_discovery_feed,
+-- (4) direct SELECT of profiles.photos via table RLS + column grant.
+
+-- 1. Storage: a photos folder is readable only by its owner. (Signature kept: policy depends on it.)
+CREATE OR REPLACE FUNCTION public.photo_folder_visible(_folder text)
+RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public, pg_temp AS $$
+  SELECT auth.uid() IS NOT NULL AND _folder = auth.uid()::text
+$$;
+
+-- 2. get_public_profile: photos returned only to the owner; everyone else gets an empty array.
+CREATE OR REPLACE FUNCTION public.get_public_profile(_id text)
+RETURNS TABLE (id text, name text, age integer, city text, bio text, work text, education text,
+               interests text[], intents text[], languages text[], lifestyle jsonb, prompt jsonb, photos jsonb)
+LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public, pg_temp AS $$
+  SELECT p.id, p.name, CASE WHEN p.dob IS NULL THEN 0 ELSE date_part('year', age(p.dob))::integer END,
+         p.city, p.bio, p.work, p.education, p.interests, p.intents, p.languages, p.lifestyle, p.prompt,
+         CASE WHEN p.id = auth.uid()::text THEN p.photos ELSE '[]'::jsonb END
+  FROM public.profiles p
+  WHERE p.id = _id AND auth.uid() IS NOT NULL AND (
+    p.id = auth.uid()::text
+    OR (p.status = 'active' AND NOT public.is_blocked_pair(p.id, auth.uid()::text))
+    OR EXISTS (SELECT 1 FROM public.matches m WHERE auth.uid()::text IN (m.user_a, m.user_b)
+               AND p.id IN (m.user_a, m.user_b)))
+$$;
+
+-- 3. get_discovery_feed: never returns photos (the feed excludes the caller's own profile).
+CREATE OR REPLACE FUNCTION public.get_discovery_feed(_limit integer DEFAULT 20)
+RETURNS TABLE (id text, name text, age integer, city text, bio text, work text, education text,
+               interests text[], intents text[], languages text[], lifestyle jsonb, prompt jsonb,
+               photos jsonb)
+LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = public, pg_temp AS $$
+DECLARE _my_id text := auth.uid()::text; _seeking text; _city text;
+BEGIN
+  IF _my_id IS NULL THEN RAISE EXCEPTION 'Authentication required'; END IF;
+  SELECT pr.seeking, pr.city INTO _seeking, _city FROM public.profiles pr WHERE pr.id = _my_id;
+  RETURN QUERY
+  SELECT p.id, p.name, CASE WHEN p.dob IS NULL THEN 0 ELSE date_part('year', age(p.dob))::integer END,
+         p.city, p.bio, p.work, p.education, p.interests, p.intents, p.languages, p.lifestyle, p.prompt,
+         '[]'::jsonb
+  FROM public.profiles p
+  WHERE p.id <> _my_id AND p.status = 'active' AND p.onboarded
+    AND NOT public.is_blocked_pair(_my_id, p.id)
+    AND (_seeking = '' OR p.gender = '' OR p.gender = _seeking)
+    AND (_city = '' OR p.city = '' OR lower(p.city) = lower(_city))
+    AND NOT EXISTS (SELECT 1 FROM public.swipes s WHERE s.from_id = _my_id AND s.to_id = p.id)
+  ORDER BY p.last_active DESC
+  LIMIT least(greatest(coalesce(_limit, 20), 1), 50);
+END $$;
+
+-- 4. Direct table reads: remove `photos` from the authenticated column grant (same list as
+--    20260101000500, minus photos). Owners read their own photos through get_my_photos().
+REVOKE SELECT ON public.profiles FROM authenticated;
+GRANT SELECT (id, user_id, status, name, gender, seeking, city, bio, work, education,
+              intents, interests, languages, lifestyle, prompt, onboarded, last_active, created_at)
+  ON public.profiles TO authenticated;
+
+CREATE OR REPLACE FUNCTION public.get_my_photos()
+RETURNS jsonb LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public, pg_temp AS $$
+  SELECT coalesce((SELECT p.photos FROM public.profiles p WHERE p.id = auth.uid()::text), '[]'::jsonb)
+$$;
+REVOKE EXECUTE ON FUNCTION public.get_my_photos() FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.get_my_photos() TO authenticated, service_role;
+
+-- CREATE OR REPLACE keeps existing grants on the two RPCs; re-assert them explicitly anyway.
+REVOKE EXECUTE ON FUNCTION public.get_public_profile(text) FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.get_public_profile(text) TO authenticated, service_role;
+REVOKE EXECUTE ON FUNCTION public.get_discovery_feed(integer) FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.get_discovery_feed(integer) TO authenticated, service_role;
diff --git a/supabase/migrations/20260101000900_photo_reviews.sql b/supabase/migrations/20260101000900_photo_reviews.sql
new file mode 100644
index 0000000..bf57361
--- /dev/null
+++ b/supabase/migrations/20260101000900_photo_reviews.sql
@@ -0,0 +1,144 @@
+-- 20260101000900_photo_reviews.sql
+-- Task 1B: per-photo review records. ADDITIVE ONLY: this migration does not change who can see photos
+-- (that is 1A now, and 1D later). It records, per owner + storage path, whether a photo is
+-- pending / approved / rejected, and binds an approval to one specific storage object.
+-- The photos JSONB `status` supplied by clients is never read here.
+
+-- 1. Table ---------------------------------------------------------------------------------
+CREATE TABLE IF NOT EXISTS public.photo_reviews (
+  owner_id         text        NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
+  path             text        NOT NULL,
+  status           text        NOT NULL DEFAULT 'pending',
+  rejection_reason text,
+  reviewed_by      uuid,
+  reviewed_at      timestamptz,
+  object_id        uuid,        -- storage.objects.id this decision applies to
+  created_at       timestamptz NOT NULL DEFAULT now(),
+  updated_at       timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY (owner_id, path),
+  CONSTRAINT photo_reviews_status_valid CHECK (status IN ('pending', 'approved', 'rejected')),
+  CONSTRAINT photo_reviews_path_in_owner_folder CHECK (left(path, length(owner_id) + 1) = owner_id || '/'),
+  CONSTRAINT photo_reviews_approved_needs_object CHECK (
+    status <> 'approved' OR (object_id IS NOT NULL AND reviewed_at IS NOT NULL)),
+  CONSTRAINT photo_reviews_rejected_needs_review CHECK (status <> 'rejected' OR reviewed_at IS NOT NULL),
+  CONSTRAINT photo_reviews_pending_is_clean CHECK (
+    status <> 'pending' OR (reviewed_at IS NULL AND object_id IS NULL AND rejection_reason IS NULL))
+);
+
+-- 2. RLS / grants: owners may read their own rows (not reviewer or object id); nobody writes from clients.
+ALTER TABLE public.photo_reviews ENABLE ROW LEVEL SECURITY;
+REVOKE ALL ON public.photo_reviews FROM PUBLIC, anon, authenticated;
+GRANT SELECT (owner_id, path, status, rejection_reason, reviewed_at, created_at, updated_at)
+  ON public.photo_reviews TO authenticated;
+GRANT ALL ON public.photo_reviews TO service_role;
+DROP POLICY IF EXISTS "owner reads own photo reviews" ON public.photo_reviews;
+CREATE POLICY "owner reads own photo reviews" ON public.photo_reviews FOR SELECT TO authenticated
+  USING (owner_id = auth.uid()::text);
+
+-- 3. Sync: one row per distinct path / thumbPath inside the owner's own folder --------------
+CREATE OR REPLACE FUNCTION public.sync_photo_reviews(_owner text, _photos jsonb)
+RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
+DECLARE _paths text[];
+BEGIN
+  SELECT coalesce(array_agg(DISTINCT s.p), ARRAY[]::text[]) INTO _paths
+  FROM (
+    SELECT e ->> k AS p
+    FROM jsonb_array_elements(CASE WHEN jsonb_typeof(_photos) = 'array' THEN _photos ELSE '[]'::jsonb END) AS e,
+         unnest(ARRAY['path', 'thumbPath']) AS k
+  ) s
+  WHERE s.p IS NOT NULL AND s.p <> '' AND left(s.p, length(_owner) + 1) = _owner || '/';
+
+  DELETE FROM public.photo_reviews WHERE owner_id = _owner AND NOT (path = ANY (_paths));
+  INSERT INTO public.photo_reviews (owner_id, path)
+    SELECT _owner, unnest(_paths) ON CONFLICT (owner_id, path) DO NOTHING;
+END $$;
+REVOKE EXECUTE ON FUNCTION public.sync_photo_reviews(text, jsonb) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.sync_photo_reviews(text, jsonb) TO service_role;
+
+CREATE OR REPLACE FUNCTION public.profiles_sync_photo_reviews()
+RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
+BEGIN
+  PERFORM public.sync_photo_reviews(NEW.id, NEW.photos);
+  RETURN NEW;
+END $$;
+REVOKE EXECUTE ON FUNCTION public.profiles_sync_photo_reviews() FROM PUBLIC, anon, authenticated;
+
+DROP TRIGGER IF EXISTS profiles_sync_photo_reviews ON public.profiles;
+CREATE TRIGGER profiles_sync_photo_reviews
+  AFTER INSERT OR UPDATE OF photos ON public.profiles
+  FOR EACH ROW EXECUTE FUNCTION public.profiles_sync_photo_reviews();
+
+-- 4. Server-only review mutation. Approval is bound to the CURRENT storage object id. -------
+CREATE OR REPLACE FUNCTION public.review_photo(_owner text, _path text, _status text, _reason text, _reviewer uuid)
+RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
+DECLARE _oid uuid;
+BEGIN
+  IF _status NOT IN ('pending', 'approved', 'rejected') THEN
+    RAISE EXCEPTION 'Invalid photo review status';
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM public.photo_reviews WHERE owner_id = _owner AND path = _path) THEN
+    RAISE EXCEPTION 'No review record for this photo';
+  END IF;
+  SELECT o.id INTO _oid FROM storage.objects o WHERE o.bucket_id = 'photos' AND o.name = _path;
+  IF _status = 'approved' AND _oid IS NULL THEN
+    RAISE EXCEPTION 'Cannot approve a photo that has no stored object';
+  END IF;
+  UPDATE public.photo_reviews SET
+    status = _status,
+    rejection_reason = CASE WHEN _status = 'rejected' THEN nullif(left(_reason, 500), '') END,
+    reviewed_by = CASE WHEN _status = 'pending' THEN NULL ELSE _reviewer END,
+    reviewed_at = CASE WHEN _status = 'pending' THEN NULL ELSE now() END,
+    object_id = CASE WHEN _status = 'pending' THEN NULL ELSE _oid END,
+    updated_at = now()
+  WHERE owner_id = _owner AND path = _path;
+END $$;
+REVOKE EXECUTE ON FUNCTION public.review_photo(text, text, text, text, uuid) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.review_photo(text, text, text, text, uuid) TO service_role;
+
+-- 5. profiles_guard: also require thumbPath to live in the owner's folder (previously unchecked).
+--    Body is the 20260101000400 definition plus the thumbPath check.
+CREATE OR REPLACE FUNCTION public.profiles_guard()
+RETURNS trigger LANGUAGE plpgsql SET search_path = public, pg_temp AS $$
+DECLARE
+  elem jsonb;
+  photo_path text;
+  thumb_path text;
+BEGIN
+  IF TG_OP = 'UPDATE' AND current_setting('request.jwt.claim.role', true) IS DISTINCT FROM 'service_role'
+     AND coalesce(auth.role(), '') <> 'service_role' THEN
+    NEW.id := OLD.id; NEW.user_id := OLD.user_id; NEW.is_demo := OLD.is_demo;
+    NEW.likes_you := OLD.likes_you; NEW.status := OLD.status; NEW.created_at := OLD.created_at;
+    IF OLD.dob IS NOT NULL AND NEW.dob IS DISTINCT FROM OLD.dob THEN
+      RAISE EXCEPTION 'Date of birth cannot be changed once saved. Contact Milo Support for assistance.';
+    END IF;
+  END IF;
+
+  IF NEW.dob IS NOT NULL AND NEW.dob > (current_date - interval '18 years')::date THEN
+    RAISE EXCEPTION 'You must be 18 or older to use Milo';
+  END IF;
+
+  IF array_length(NEW.interests, 1) > 15 OR array_length(NEW.intents, 1) > 6 OR array_length(NEW.languages, 1) > 16
+     OR jsonb_array_length(NEW.photos) > 6 THEN
+    RAISE EXCEPTION 'Exceeded allowed number of profile items';
+  END IF;
+
+  -- Validate photo path ownership: every photo path and thumbPath MUST start with NEW.id || '/' unless empty
+  IF jsonb_typeof(NEW.photos) = 'array' THEN
+    FOR elem IN SELECT * FROM jsonb_array_elements(NEW.photos) LOOP
+      photo_path := elem->>'path';
+      IF photo_path IS NOT NULL AND photo_path <> '' AND NOT (photo_path LIKE NEW.id || '/%') THEN
+        RAISE EXCEPTION 'Invalid photo path: must belong to user folder';
+      END IF;
+      thumb_path := elem->>'thumbPath';
+      IF thumb_path IS NOT NULL AND thumb_path <> ''
+         AND left(thumb_path, length(NEW.id) + 1) <> NEW.id || '/' THEN
+        RAISE EXCEPTION 'Invalid photo thumbnail path: must belong to user folder';
+      END IF;
+    END LOOP;
+  END IF;
+
+  RETURN NEW;
+END $$;
+
+-- 6. Backfill: every existing photo path / thumbPath starts as PENDING (nothing is auto-approved).
+SELECT public.sync_photo_reviews(p.id, p.photos) FROM public.profiles p;
diff --git a/supabase/migrations/20260101001000_photo_visibility_approved_only.sql b/supabase/migrations/20260101001000_photo_visibility_approved_only.sql
new file mode 100644
index 0000000..2119f9e
--- /dev/null
+++ b/supabase/migrations/20260101001000_photo_visibility_approved_only.sql
@@ -0,0 +1,158 @@
+-- 20260101001000_photo_visibility_approved_only.sql
+-- Task 1D: replace the 1A owner-only stopgap with APPROVED-ONLY visibility.
+-- A photo is visible to anyone but its owner only when ALL hold:
+--   * its photo_reviews row is 'approved' and bound to the CURRENT storage.objects.id for that path
+--     (so replacing the file invalidates the approval),
+--   * it is not under the owner's verification/ folder (selfies are never public),
+--   * the owner is an active, onboarded profile and the pair is not blocked.
+-- Client-supplied `status` inside photos JSONB is never trusted or returned.
+
+-- 0. Verification selfies can never have review rows (so they can never be approved) --------
+DELETE FROM public.photo_reviews WHERE split_part(path, '/', 2) = 'verification';
+ALTER TABLE public.photo_reviews
+  ADD CONSTRAINT photo_reviews_not_verification CHECK (split_part(path, '/', 2) <> 'verification');
+
+CREATE OR REPLACE FUNCTION public.sync_photo_reviews(_owner text, _photos jsonb)
+RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
+DECLARE _paths text[];
+BEGIN
+  SELECT coalesce(array_agg(DISTINCT s.p), ARRAY[]::text[]) INTO _paths
+  FROM (
+    SELECT e ->> k AS p
+    FROM jsonb_array_elements(CASE WHEN jsonb_typeof(_photos) = 'array' THEN _photos ELSE '[]'::jsonb END) AS e,
+         unnest(ARRAY['path', 'thumbPath']) AS k
+  ) s
+  WHERE s.p IS NOT NULL AND s.p <> '' AND left(s.p, length(_owner) + 1) = _owner || '/'
+    AND split_part(s.p, '/', 2) <> 'verification';
+
+  DELETE FROM public.photo_reviews WHERE owner_id = _owner AND NOT (path = ANY (_paths));
+  INSERT INTO public.photo_reviews (owner_id, path)
+    SELECT _owner, unnest(_paths) ON CONFLICT (owner_id, path) DO NOTHING;
+END $$;
+
+-- 1. Is this exact path approved for the object that exists right now? --------------------
+CREATE OR REPLACE FUNCTION public.photo_is_public(_owner text, _path text)
+RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public, pg_temp AS $$
+  SELECT coalesce(
+    _owner IS NOT NULL AND _path IS NOT NULL AND _path <> ''
+    AND left(_path, length(_owner) + 1) = _owner || '/'
+    AND split_part(_path, '/', 2) <> 'verification'
+    AND EXISTS (
+      SELECT 1
+      FROM public.photo_reviews r
+      JOIN storage.objects o ON o.bucket_id = 'photos' AND o.name = r.path
+      WHERE r.owner_id = _owner AND r.path = _path
+        AND r.status = 'approved' AND r.object_id IS NOT NULL AND r.object_id = o.id),
+    false)
+$$;
+
+-- 2. Photos as other people may see them: approved only, whitelisted fields, no status. ------
+CREATE OR REPLACE FUNCTION public.public_photos(_owner text, _photos jsonb)
+RETURNS jsonb LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public, pg_temp AS $$
+  SELECT coalesce(jsonb_agg(
+           jsonb_strip_nulls(jsonb_build_object(
+             'id', t.e ->> 'id',
+             'path', t.e ->> 'path',
+             'thumbPath', CASE WHEN public.photo_is_public(_owner, t.e ->> 'thumbPath') THEN t.e ->> 'thumbPath' END))
+           ORDER BY t.ord), '[]'::jsonb)
+  FROM jsonb_array_elements(CASE WHEN jsonb_typeof(_photos) = 'array' THEN _photos ELSE '[]'::jsonb END)
+         WITH ORDINALITY AS t(e, ord)
+  WHERE public.photo_is_public(_owner, t.e ->> 'path')
+$$;
+
+-- 3. Photos as their owner sees them: all of them, with the SERVER-derived review status. -----
+CREATE OR REPLACE FUNCTION public.owner_photos(_owner text, _photos jsonb)
+RETURNS jsonb LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public, pg_temp AS $$
+  SELECT coalesce(jsonb_agg(
+           jsonb_strip_nulls(jsonb_build_object(
+             'id', t.e ->> 'id',
+             'path', t.e ->> 'path',
+             'thumbPath', t.e ->> 'thumbPath',
+             'status', CASE
+                         WHEN r.status = 'approved' AND NOT public.photo_is_public(_owner, t.e ->> 'path') THEN 'pending'
+                         ELSE coalesce(r.status, 'pending') END,
+             'rejectionReason', r.rejection_reason))
+           ORDER BY t.ord), '[]'::jsonb)
+  FROM jsonb_array_elements(CASE WHEN jsonb_typeof(_photos) = 'array' THEN _photos ELSE '[]'::jsonb END)
+         WITH ORDINALITY AS t(e, ord)
+  LEFT JOIN public.photo_reviews r ON r.owner_id = _owner AND r.path = t.e ->> 'path'
+$$;
+
+-- 4. Storage read policy: owner folder, or an approved + bound object of a visible profile. ---
+CREATE OR REPLACE FUNCTION public.photo_object_readable(_name text)
+RETURNS boolean LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public, pg_temp AS $$
+  SELECT auth.uid() IS NOT NULL AND (
+    (storage.foldername(_name))[1] = auth.uid()::text
+    OR (
+      public.photo_is_public((storage.foldername(_name))[1], _name)
+      AND EXISTS (
+        SELECT 1 FROM public.profiles p
+        WHERE p.id = (storage.foldername(_name))[1] AND p.status = 'active' AND p.onboarded
+          AND NOT public.is_blocked_pair(p.id, auth.uid()::text))))
+$$;
+
+DROP POLICY IF EXISTS "photos read visible" ON storage.objects;
+CREATE POLICY "photos read visible" ON storage.objects FOR SELECT TO authenticated
+  USING (bucket_id = 'photos' AND public.photo_object_readable(name));
+
+-- No UPDATE policy: stored photo objects can never be overwritten in place. Replacement means a new
+-- path (client uploads with upsert:false); a deleted-and-reuploaded path gets a new object id and
+-- therefore loses any approval.
+DROP POLICY IF EXISTS "photos update own folder" ON storage.objects;
+
+-- 5. RPCs -------------------------------------------------------------------------------------
+CREATE OR REPLACE FUNCTION public.get_public_profile(_id text)
+RETURNS TABLE (id text, name text, age integer, city text, bio text, work text, education text,
+               interests text[], intents text[], languages text[], lifestyle jsonb, prompt jsonb, photos jsonb)
+LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public, pg_temp AS $$
+  SELECT p.id, p.name, CASE WHEN p.dob IS NULL THEN 0 ELSE date_part('year', age(p.dob))::integer END,
+         p.city, p.bio, p.work, p.education, p.interests, p.intents, p.languages, p.lifestyle, p.prompt,
+         CASE
+           WHEN p.id = auth.uid()::text THEN public.owner_photos(p.id, p.photos)
+           WHEN p.status = 'active' AND p.onboarded AND NOT public.is_blocked_pair(p.id, auth.uid()::text)
+             THEN public.public_photos(p.id, p.photos)
+           ELSE '[]'::jsonb END
+  FROM public.profiles p
+  WHERE p.id = _id AND auth.uid() IS NOT NULL AND (
+    p.id = auth.uid()::text
+    OR (p.status = 'active' AND NOT public.is_blocked_pair(p.id, auth.uid()::text))
+    OR EXISTS (SELECT 1 FROM public.matches m WHERE auth.uid()::text IN (m.user_a, m.user_b)
+               AND p.id IN (m.user_a, m.user_b)))
+$$;
+
+CREATE OR REPLACE FUNCTION public.get_discovery_feed(_limit integer DEFAULT 20)
+RETURNS TABLE (id text, name text, age integer, city text, bio text, work text, education text,
+               interests text[], intents text[], languages text[], lifestyle jsonb, prompt jsonb,
+               photos jsonb)
+LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = public, pg_temp AS $$
+DECLARE _my_id text := auth.uid()::text; _seeking text; _city text;
+BEGIN
+  IF _my_id IS NULL THEN RAISE EXCEPTION 'Authentication required'; END IF;
+  SELECT pr.seeking, pr.city INTO _seeking, _city FROM public.profiles pr WHERE pr.id = _my_id;
+  RETURN QUERY
+  SELECT p.id, p.name, CASE WHEN p.dob IS NULL THEN 0 ELSE date_part('year', age(p.dob))::integer END,
+         p.city, p.bio, p.work, p.education, p.interests, p.intents, p.languages, p.lifestyle, p.prompt,
+         public.public_photos(p.id, p.photos)
+  FROM public.profiles p
+  WHERE p.id <> _my_id AND p.status = 'active' AND p.onboarded
+    AND NOT public.is_blocked_pair(_my_id, p.id)
+    AND (_seeking = '' OR p.gender = '' OR p.gender = _seeking)
+    AND (_city = '' OR p.city = '' OR lower(p.city) = lower(_city))
+    AND NOT EXISTS (SELECT 1 FROM public.swipes s WHERE s.from_id = _my_id AND s.to_id = p.id)
+  ORDER BY p.last_active DESC
+  LIMIT least(greatest(coalesce(_limit, 20), 1), 50);
+END $$;
+
+CREATE OR REPLACE FUNCTION public.get_my_photos()
+RETURNS jsonb LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public, pg_temp AS $$
+  SELECT coalesce(
+    (SELECT public.owner_photos(p.id, p.photos) FROM public.profiles p WHERE p.id = auth.uid()::text),
+    '[]'::jsonb)
+$$;
+
+-- 6. Grants: internal helpers are not client-callable; the storage policy helper must be. ------
+REVOKE EXECUTE ON FUNCTION public.photo_is_public(text, text), public.public_photos(text, jsonb),
+  public.owner_photos(text, jsonb), public.photo_object_readable(text) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.photo_is_public(text, text), public.public_photos(text, jsonb),
+  public.owner_photos(text, jsonb), public.photo_object_readable(text) TO service_role;
+GRANT EXECUTE ON FUNCTION public.photo_object_readable(text) TO authenticated;
diff --git a/supabase/migrations/20260101001100_uniform_like_quota.sql b/supabase/migrations/20260101001100_uniform_like_quota.sql
new file mode 100644
index 0000000..917e267
--- /dev/null
+++ b/supabase/migrations/20260101001100_uniform_like_quota.sql
@@ -0,0 +1,84 @@
+-- 20260101001100_uniform_like_quota.sql
+-- Task Q1: every user follows the configured daily limits (default 10 ordinary likes, 3 priority likes,
+-- reset at midnight IST). Removes the paid-tier ('premium' / 'plus' / 'vip') bypass of the ordinary-like
+-- limit that 20260101000700 introduced; the MVP has no paid billing. Otherwise identical to that version.
+-- The subscription tables and other tier-gated features (received-likes read, undo-pass) are untouched.
+CREATE OR REPLACE FUNCTION public.record_swipe(_to_id text, _kind text)
+RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS $$
+DECLARE
+  _from_id text := auth.uid()::text;
+  _today date := (timezone('Asia/Kolkata', now()))::date;
+  _like_limit int := public.setting_int('daily_like_limit', 10);
+  _prio_limit int := public.setting_int('daily_priority_like_limit', 3);
+  _likes int; _prio int;
+  _me public.profiles; _them public.profiles;
+  _existing text; _match_id uuid; _is_match boolean := false;
+BEGIN
+  IF _from_id IS NULL THEN RAISE EXCEPTION 'Authentication required'; END IF;
+  IF _to_id IS NULL OR _from_id = _to_id THEN RAISE EXCEPTION 'Cannot swipe on own profile'; END IF;
+  IF _kind IS NULL OR _kind NOT IN ('like','pass','priority') THEN RAISE EXCEPTION 'Invalid swipe kind'; END IF;
+
+  -- Serialise swipes between the same pair so two simultaneous likes always produce a match.
+  PERFORM pg_advisory_xact_lock(hashtextextended(least(_from_id,_to_id) || '|' || greatest(_from_id,_to_id), 0));
+
+  SELECT * INTO _me FROM public.profiles WHERE id = _from_id;
+  IF _me.id IS NULL OR _me.status <> 'active' THEN RAISE EXCEPTION 'Account not active'; END IF;
+  SELECT * INTO _them FROM public.profiles WHERE id = _to_id;
+  IF _them.id IS NULL OR _them.status <> 'active' OR public.is_blocked_pair(_from_id, _to_id)
+     OR (_me.seeking <> '' AND _them.gender <> '' AND _them.gender <> _me.seeking) THEN
+    RAISE EXCEPTION 'Profile not available';
+  END IF;
+
+  SELECT kind INTO _existing FROM public.swipes WHERE from_id = _from_id AND to_id = _to_id;
+
+  -- Quota applies only when this swipe newly spends a like / priority like.
+  IF _kind IN ('like','priority') AND _existing IS DISTINCT FROM _kind THEN
+    INSERT INTO public.user_daily_quotas (user_id, ist_date) VALUES (_from_id, _today)
+      ON CONFLICT (user_id, ist_date) DO NOTHING;
+    SELECT likes_used, super_likes_used INTO _likes, _prio FROM public.user_daily_quotas
+      WHERE user_id = _from_id AND ist_date = _today FOR UPDATE;
+
+    IF _kind = 'like' AND _likes >= _like_limit THEN
+      RETURN jsonb_build_object('success', false, 'error', 'daily_like_limit_reached',
+        'likes_remaining', 0, 'reset_at_ist', _today + 1);
+    END IF;
+
+    IF _kind = 'priority' AND _prio >= _prio_limit THEN
+      RETURN jsonb_build_object('success', false, 'error', 'daily_super_like_limit_reached',
+        'super_likes_remaining', 0,
+        'likes_remaining', greatest(0, _like_limit - _likes),
+        'reset_at_ist', _today + 1);
+    END IF;
+
+    UPDATE public.user_daily_quotas
+      SET likes_used = likes_used + (CASE WHEN _kind = 'like' THEN 1 ELSE 0 END),
+          super_likes_used = super_likes_used + (CASE WHEN _kind = 'priority' THEN 1 ELSE 0 END),
+          updated_at = now()
+      WHERE user_id = _from_id AND ist_date = _today
+      RETURNING likes_used, super_likes_used INTO _likes, _prio;
+  ELSE
+    SELECT likes_used, super_likes_used INTO _likes, _prio FROM public.user_daily_quotas
+      WHERE user_id = _from_id AND ist_date = _today;
+    _likes := coalesce(_likes, 0); _prio := coalesce(_prio, 0);
+  END IF;
+
+  INSERT INTO public.swipes (from_id, to_id, kind) VALUES (_from_id, _to_id, _kind)
+    ON CONFLICT (from_id, to_id) DO UPDATE SET kind = EXCLUDED.kind, created_at = now();
+
+  IF _kind <> 'pass' AND (
+       EXISTS (SELECT 1 FROM public.swipes WHERE from_id = _to_id AND to_id = _from_id AND kind <> 'pass')
+       OR (_them.is_demo AND _them.likes_you)) THEN
+    INSERT INTO public.matches (user_a, user_b) VALUES (least(_from_id,_to_id), greatest(_from_id,_to_id))
+      ON CONFLICT (user_a, user_b) DO NOTHING;
+    SELECT id INTO _match_id FROM public.matches
+      WHERE user_a = least(_from_id,_to_id) AND user_b = greatest(_from_id,_to_id);
+    _is_match := true;
+  END IF;
+
+  RETURN jsonb_build_object('success', true, 'is_match', _is_match, 'match_id', _match_id,
+    'likes_remaining', greatest(0, _like_limit - _likes),
+    'super_likes_remaining', greatest(0, _prio_limit - _prio));
+END $$;
+
+REVOKE EXECUTE ON FUNCTION public.record_swipe(text, text) FROM PUBLIC, anon;
+GRANT EXECUTE ON FUNCTION public.record_swipe(text, text) TO authenticated, service_role;
